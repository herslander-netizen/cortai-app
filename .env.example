# Variáveis de ambiente da camada de IA da CortAI — SÓ NOMES, sem valores reais.
# Em produção elas ficam como segredos do servidor (Lovable/Cloudflare), nunca no Git,
# nunca com prefixo VITE_ (isso expõe no navegador).

# --- Modelo atual (Lovable AI Gateway) ---
# LOVABLE_API_KEY=            # já existente; gerenciada pelo Lovable

# --- Provedor alternativo (ex.: GPT-OSS-20B hospedado) — migração por canal ---
# GPT4Free hospedado no Railway (chave G4F_API_KEY deve existir também neste runtime).
# Ativa somente depois de validar o endpoint/modelo e configurar o segredo no servidor:
# CORTAI_AI_PROVIDER=gpt4free
# CORTAI_AI_MODEL=gpt-4o                 # exemplo; confirme um modelo com suporte a ferramentas
# G4F_API_KEY=                           # mesmo valor do segredo do serviço GPT4Free; nunca no frontend
# CORTAI_AI_CANAIS=painel                # manter só o painel até passar nos testes
# A URL padrão do gateway GPT4Free é configurada no código. Para outro host, use CORTAI_AI_BASE_URL.
# Sem CORTAI_AI_PROVIDER nada muda. Para voltar ao modelo anterior: apague estas linhas
# (ou tire o canal de CORTAI_AI_CANAIS). Não há fallback automático entre provedores.
# CORTAI_AI_PROVIDER=openai_compatible
# CORTAI_AI_BASE_URL=https://<provedor>/v1      # precisa ser https (http só em localhost)
# CORTAI_AI_MODEL=<nome do modelo no provedor>   # ex.: o id de gpt-oss-20b naquele provedor
# CORTAI_AI_API_KEY=
# CORTAI_AI_CANAIS=painel                        # painel,whatsapp,site — padrão: só painel
# CORTAI_AI_REASONING_EFFORT=low                 # opcional: low | medium | high
# CORTAI_AI_TIMEOUT_MS=45000                     # opcional: 1000 a 120000

# --- Transcrição de voz no servidor (opcional; a voz do navegador já é gratuita) ---
# API compatível com OpenAI /audio/transcriptions (ex.: Whisper do Groq). Sem isto usa o gateway do Lovable.
# CORTAI_STT_BASE_URL=https://api.groq.com/openai/v1
# CORTAI_STT_MODEL=whisper-large-v3-turbo
# CORTAI_STT_API_KEY=

# --- Execução direta (painel) ---
# Padrão: ligada só para agendar quando cliente, serviço e horário foram provados por consultas do turno.
# CORTAI_EXECUCAO_DIRETA=false                    # false/0/off: toda escrita volta a exigir o SIM
# Comando por VOZ pede conferência ("Entendi assim… Confirmar?"). Para executar direto também por voz:
# CORTAI_EXECUCAO_DIRETA_VOZ=true
# Modo básico (sem IA) como rede de segurança do painel; false desliga.
# CORTAI_MODO_BASICO=false

# Conferência visível do pedido (cliente, serviço, regras da agenda, provas) no painel.
# CORTAI_CONFERENCIA=false                        # false/0/off: volta ao fluxo sem conferência

# --- Observabilidade (Langfuse) — opcional; sem as chaves fica desligada ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # ou a URL da sua instalação (https)
# CORTAI_OBS_ENABLED=true                        # false desliga sem apagar as chaves
# CORTAI_OBS_SAMPLE_RATE=1                       # 0 a 1; turnos com falha sempre são enviados
# CORTAI_OBS_SALT=                               # sem ele NENHUM id (negócio/pessoa/conversa) é enviado
# CORTAI_OBS_CAPTURE_TEXT=false                  # true envia texto mascarado e truncado
# CORTAI_OBS_TIMEOUT_MS=1500                     # espera máxima do envio ao fim de cada turno
# CORTAI_PROMPT_VERSION=v1                       # rótulo para comparar versões do prompt

# --- Avaliação local (Promptfoo) — só na sua máquina, nunca em produção ---
# PROMPTFOO_OSS_BASE_URL=
# PROMPTFOO_OSS_MODEL=
# PROMPTFOO_OSS_API_KEY=
# PROMPTFOO_OSS_REASONING_EFFORT=low
# PROMPTFOO_JUIZ_BASE_URL=                       # modelo-juiz opcional (suíte de qualidade)
# PROMPTFOO_JUIZ_MODEL=
# PROMPTFOO_JUIZ_API_KEY=

# --- Supabase independente da reconstrução ---
# Configure estes valores no ambiente local e no runtime da hospedagem.
# Não use service_role nem sb_secret em variáveis VITE_ ou no navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Conectores portáveis (preencher apenas em ambiente privado) ---
# WhatsApp: evolution | zapi | meta | generic
WHATSAPP_PROVIDER=evolution
CORTAI_PUBLIC_BASE_URL=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_SECRET=
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=

# IA alternativa (só configurar o provedor que for usar)
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Pagamentos / notificações opcionais
ASAAS_API_URL=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
RESEND_API_KEY=
