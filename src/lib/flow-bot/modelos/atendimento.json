    },
    {
      "id": "e39",
      "from": "tem-pagamento",
      "to": "sem-pagamento",
      "port": "false"
    },
    {
      "id": "e40",
      "from": "sem-pagamento",
      "to": "fim",
      "port": "next"
    },
    {
      "id": "e41",
      "from": "tem-endereco-menu",
      "to": "horario-e-endereco",
      "port": "true"
    },
    {
      "id": "e42",
      "from": "tem-endereco-menu",
      "to": "horario-sem-endereco",
      "port": "false"
    },
    {
      "id": "e43",
      "from": "horario-sem-endereco",
      "to": "fim",
      "port": "next"
    },
    {
      "id": "e44",
      "from": "tem-proximo-horario",
      "to": "agendar",
      "port": "true"
    },
    {
      "id": "e45",
      "from": "tem-proximo-horario",
      "to": "agendar-sem-proximo",
      "port": "false"
    },
    {
      "id": "e46",
      "from": "agendar-sem-proximo",
      "to": "fim",
      "port": "next"
    }
  ]
}
