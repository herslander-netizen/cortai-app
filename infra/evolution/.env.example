# Copie para .env no servidor e preencha. Não suba o .env para o Git.
# Endereço público HTTPS em que a Evolution vai responder (ex.: https://evolution.seudominio.com.br).
EVOLUTION_SERVER_URL=
# Chave de acesso da Evolution (gere com: openssl rand -hex 32). É a mesma do segredo EVOLUTION_API_KEY no GitHub.
EVOLUTION_API_KEY=
# Senha do banco interno da Evolution (gere com: openssl rand -hex 24).
POSTGRES_PASSWORD=
